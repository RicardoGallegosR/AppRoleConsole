<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>

		<Version>1.$([System.DateTime]::Now.ToString("yyMM")).$([System.DateTime]::Now.ToString("dd")).$([System.DateTime]::Now.ToString("HH"))</Version>
		<FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<InformationalVersion>$(Version)</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Paneles\Instalaciones\Drivers\" />
		<Folder Include="Paneles\Instalaciones\Impresoras\" />
		<Folder Include="Paneles\IP\" />
		<Folder Include="Paneles\Puertos\COM\" />
		<Folder Include="Paneles\Puertos\Impresora\" />
		<Folder Include="Paneles\Servicios\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="DotNetZip" Version="1.16.0" />
	  <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
	  <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
	  <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FrmComun\FrmComun.csproj" />
		<ProjectReference Include="..\SQLSIVEV\SQLSIVEV.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>